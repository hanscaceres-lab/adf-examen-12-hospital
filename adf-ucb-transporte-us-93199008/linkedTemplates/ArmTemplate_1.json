	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/df_oro_dim_servicio_cargo')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "oro"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "plata_facturacion",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "oro_dim_servicio_cargo",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [],
					"scriptLines": [
						"source(output(",
						"          tipo_cargo as string,",
						"          estado_pago as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT DISTINCT charge_type AS tipo_cargo, payment_status AS estado_pago FROM silver.billing',",
						"     format: 'query') ~> source1",
						"source1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          servicio_cargo_key as integer,",
						"          tipo_cargo as string,",
						"          estado_pago as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     preSQLs:['DELETE FROM gold.fact_facturacion','DELETE FROM gold.fact_admisiones','DELETE FROM gold.dim_servicio_cargo','DBCC CHECKIDENT (\\'gold.dim_servicio_cargo\\', RESEED, 0)'],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          tipo_cargo,",
						"          estado_pago",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_oro_fact_admisiones')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "oro"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "plata_admisiones",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "oro_fact_admisiones",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [],
					"scriptLines": [
						"source(output(",
						"          admission_id_bk as integer,",
						"          paciente_key as integer,",
						"          departamento_key as integer,",
						"          diagnostico_key as integer,",
						"          fecha_ingreso_key as integer,",
						"          fecha_alta_key as integer,",
						"          medico_id as integer,",
						"          dias_estancia as integer,",
						"          conteo_admisiones as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT a.admission_id AS admission_id_bk, dp.paciente_key, dd.departamento_key, COALESCE(dg.diagnostico_key, nd.diagnostico_key) AS diagnostico_key, (YEAR(a.admission_date)*10000+MONTH(a.admission_date)*100+DAY(a.admission_date)) AS fecha_ingreso_key, CASE WHEN a.discharge_date IS NULL THEN NULL ELSE (YEAR(a.discharge_date)*10000+MONTH(a.discharge_date)*100+DAY(a.discharge_date)) END AS fecha_alta_key, a.attending_doctor_id AS medico_id, DATEDIFF(DAY,a.admission_date,a.discharge_date) AS dias_estancia, 1 AS conteo_admisiones FROM silver.admissions a JOIN gold.dim_paciente dp ON dp.patient_id_bk=a.patient_id JOIN gold.dim_departamento dd ON dd.nombre_departamento=a.department OUTER APPLY (SELECT TOP 1 d.icd_code, d.severity, d.diagnosis_description FROM silver.diagnoses d WHERE d.admission_id=a.admission_id ORDER BY CASE d.severity WHEN \\'Critical\\' THEN 4 WHEN \\'Severe\\' THEN 3 WHEN \\'Moderate\\' THEN 2 WHEN \\'Mild\\' THEN 1 ELSE 0 END DESC, d.diagnosis_id) dx LEFT JOIN gold.dim_diagnostico dg ON dg.codigo_icd=dx.icd_code AND dg.nivel_severidad=ISNULL(dx.severity,\\'Desconocida\\') AND ISNULL(dg.descripcion_patologia,\\'\\')=ISNULL(dx.diagnosis_description,\\'\\') CROSS JOIN (SELECT diagnostico_key FROM gold.dim_diagnostico WHERE codigo_icd=\\'N/D\\') nd',",
						"     format: 'query') ~> source1",
						"source1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          admision_key as long,",
						"          admission_id_bk as integer,",
						"          paciente_key as integer,",
						"          departamento_key as integer,",
						"          diagnostico_key as integer,",
						"          fecha_ingreso_key as integer,",
						"          fecha_alta_key as integer,",
						"          medico_id as integer,",
						"          dias_estancia as integer,",
						"          conteo_admisiones as integer",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     preSQLs:['DELETE FROM gold.fact_facturacion','DELETE FROM gold.fact_admisiones','DBCC CHECKIDENT (\\'gold.fact_admisiones\\', RESEED, 0)'],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          admission_id_bk,",
						"          paciente_key,",
						"          departamento_key,",
						"          diagnostico_key,",
						"          fecha_ingreso_key,",
						"          fecha_alta_key,",
						"          medico_id,",
						"          dias_estancia,",
						"          conteo_admisiones",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_oro_fact_facturacion')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "oro"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "plata_facturacion",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "oro_fact_facturacion",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [],
					"scriptLines": [
						"source(output(",
						"          billing_id_bk as integer,",
						"          admission_id_bk as integer,",
						"          paciente_key as integer,",
						"          departamento_key as integer,",
						"          servicio_cargo_key as integer,",
						"          fecha_pago_key as integer,",
						"          monto_facturado as decimal(12,2),",
						"          conteo_transacciones as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT b.billing_id AS billing_id_bk, b.admission_id AS admission_id_bk, fa.paciente_key, fa.departamento_key, sc.servicio_cargo_key, CASE WHEN b.payment_date IS NULL THEN NULL ELSE (YEAR(b.payment_date)*10000+MONTH(b.payment_date)*100+DAY(b.payment_date)) END AS fecha_pago_key, b.amount AS monto_facturado, 1 AS conteo_transacciones FROM silver.billing b JOIN gold.fact_admisiones fa ON fa.admission_id_bk=b.admission_id JOIN gold.dim_servicio_cargo sc ON sc.tipo_cargo=b.charge_type AND sc.estado_pago=b.payment_status',",
						"     format: 'query') ~> source1",
						"source1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          facturacion_key as long,",
						"          billing_id_bk as integer,",
						"          admission_id_bk as integer,",
						"          paciente_key as integer,",
						"          departamento_key as integer,",
						"          servicio_cargo_key as integer,",
						"          fecha_pago_key as integer,",
						"          monto_facturado as decimal(12,2),",
						"          conteo_transacciones as integer",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     preSQLs:['DELETE FROM gold.fact_facturacion','DBCC CHECKIDENT (\\'gold.fact_facturacion\\', RESEED, 0)'],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          billing_id_bk,",
						"          admission_id_bk,",
						"          paciente_key,",
						"          departamento_key,",
						"          servicio_cargo_key,",
						"          fecha_pago_key,",
						"          monto_facturado,",
						"          conteo_transacciones",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_plata_admisiones')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "plata"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "bronce_admisiones",
								"type": "DatasetReference"
							},
							"name": "source1"
						},
						{
							"dataset": {
								"referenceName": "plata_pacientes",
								"type": "DatasetReference"
							},
							"name": "source2"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "plata_admisiones",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "derivedColumn1"
						},
						{
							"name": "DerivedColumn2"
						},
						{
							"name": "exist1"
						},
						{
							"name": "filter"
						}
					],
					"scriptLines": [
						"source(output(",
						"          admission_id as string,",
						"          patient_id as string,",
						"          admission_date as string,",
						"          discharge_date as string,",
						"          department as string,",
						"          attending_doctor_id as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> source1",
						"source(output(",
						"          pat_ref as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT patient_id AS pat_ref FROM silver.patients',",
						"     format: 'query') ~> source2",
						"source1 derive(admission_id = toInteger(trim(admission_id)),",
						"          patient_id = toInteger(trim(patient_id)),",
						"          attending_doctor_id = toInteger(trim(attending_doctor_id)),",
						"          department = case(regexMatch(lower(trim(department)),'er|emerg.*'),'Emergency', regexMatch(lower(trim(department)),'card.*'),'Cardiology', regexMatch(lower(trim(department)),'gen.*'),'General Surgery', regexMatch(lower(trim(department)),'neuro.*|nuer.*'),'Neurology', regexMatch(lower(trim(department)),'onco.*'),'Oncology', regexMatch(lower(trim(department)),'ortho.*'),'Orthopedics', regexMatch(lower(trim(department)),'ped.*|paed.*'),'Pediatrics', toString(null())),",
						"          adm_iso = case(regexMatch(admission_date,'[0-9]{4}-[0-9]{2}-[0-9]{2}'), admission_date, regexMatch(admission_date,'[0-9]{2}/[0-9]{2}/[0-9]{4}'), concat(substring(admission_date,7,4),'-',substring(admission_date,1,2),'-',substring(admission_date,4,2)), regexMatch(admission_date,'[0-9]{2}-[0-9]{2}-[0-9]{2}'), concat(iif(toInteger(substring(admission_date,7,2))<=26,'20','19'),substring(admission_date,7,2),'-',substring(admission_date,1,2),'-',substring(admission_date,4,2)), regexMatch(admission_date,'[0-9]{2}-[A-Za-z]{3}-[0-9]{4}'), concat(substring(admission_date,8,4),'-',lpad(toString(toInteger((locate(lower(substring(admission_date,4,3)),'janfebmaraprmayjunjulaugsepoctnovdec')+2)/3)),2,'0'),'-',substring(admission_date,1,2)), regexMatch(admission_date,'[A-Za-z]+ [0-9]{1,2}, [0-9]{4}'), concat(right(admission_date,4),'-',lpad(toString(toInteger((locate(lower(substring(admission_date,1,3)),'janfebmaraprmayjunjulaugsepoctnovdec')+2)/3)),2,'0'),'-',lpad(regexReplace(split(admission_date,' ')[2],',',''),2,'0')), toString(null())),",
						"          dis_iso = case(regexMatch(discharge_date,'[0-9]{4}-[0-9]{2}-[0-9]{2}'), discharge_date, regexMatch(discharge_date,'[0-9]{2}/[0-9]{2}/[0-9]{4}'), concat(substring(discharge_date,7,4),'-',substring(discharge_date,1,2),'-',substring(discharge_date,4,2)), regexMatch(discharge_date,'[0-9]{2}-[0-9]{2}-[0-9]{2}'), concat(iif(toInteger(substring(discharge_date,7,2))<=26,'20','19'),substring(discharge_date,7,2),'-',substring(discharge_date,1,2),'-',substring(discharge_date,4,2)), regexMatch(discharge_date,'[0-9]{2}-[A-Za-z]{3}-[0-9]{4}'), concat(substring(discharge_date,8,4),'-',lpad(toString(toInteger((locate(lower(substring(discharge_date,4,3)),'janfebmaraprmayjunjulaugsepoctnovdec')+2)/3)),2,'0'),'-',substring(discharge_date,1,2)), regexMatch(discharge_date,'[A-Za-z]+ [0-9]{1,2}, [0-9]{4}'), concat(right(discharge_date,4),'-',lpad(toString(toInteger((locate(lower(substring(discharge_date,1,3)),'janfebmaraprmayjunjulaugsepoctnovdec')+2)/3)),2,'0'),'-',lpad(regexReplace(split(discharge_date,' ')[2],',',''),2,'0')), toString(null()))) ~> derivedColumn1",
						"derivedColumn1 derive(admission_date = toDate(iif(adm_iso>='2000-01-01' && adm_iso<=toString(currentDate(),'yyyy-MM-dd'), adm_iso, toString(null())),'yyyy-MM-dd'),",
						"          discharge_date = toDate(iif(dis_iso>=adm_iso && dis_iso<=toString(currentDate(),'yyyy-MM-dd'), dis_iso, toString(null())),'yyyy-MM-dd')) ~> DerivedColumn2",
						"DerivedColumn2, source2 lookup(patient_id == pat_ref,",
						"     multiple: false,",
						"     pickup: 'any',",
						"     broadcast: 'auto')~> exist1",
						"exist1 filter(!isNull(admission_id) && !isNull(admission_date) && !isNull(department) && !isNull(attending_doctor_id) && !isNull(pat_ref)) ~> filter",
						"filter sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          admission_id as integer,",
						"          patient_id as integer,",
						"          admission_date as date,",
						"          discharge_date as date,",
						"          department as string,",
						"          attending_doctor_id as integer",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          admission_id,",
						"          patient_id,",
						"          admission_date,",
						"          discharge_date,",
						"          department,",
						"          attending_doctor_id",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_plata_dianosticos')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "plata"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "bronce_diagnosticos",
								"type": "DatasetReference"
							},
							"name": "source1"
						},
						{
							"dataset": {
								"referenceName": "plata_admisiones",
								"type": "DatasetReference"
							},
							"name": "source2"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "plata_diagnostico",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "derivedColumn1"
						},
						{
							"name": "derivedColumn2"
						},
						{
							"name": "exist1"
						},
						{
							"name": "filter"
						}
					],
					"scriptLines": [
						"source(output(",
						"          diagnosis_id as string,",
						"          admission_id as string,",
						"          diagnosis_description as string,",
						"          severity as string,",
						"          icd_code as string,",
						"          n as long",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT b.diagnosis_id, b.admission_id, b.diagnosis_description, b.severity, LTRIM(RTRIM(s.value)) AS icd_code, ROW_NUMBER() OVER (PARTITION BY b.diagnosis_id ORDER BY s.value) AS n FROM bronze.diagnoses b CROSS APPLY STRING_SPLIT(b.icd_code, CHAR(44)) s WHERE LEN(LTRIM(RTRIM(s.value))) > 0',",
						"     format: 'query') ~> source1",
						"source(output(",
						"          adm_ref as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT admission_id AS adm_ref FROM silver.admissions',",
						"     format: 'query') ~> source2",
						"source1 derive(diagnosis_id = toInteger(toInteger(trim(diagnosis_id)) + 100000*(n-1)),",
						"          admission_id = toInteger(trim(admission_id)),",
						"          severity = case(lower(trim(severity))=='mild','Mild', lower(trim(severity))=='moderate','Moderate', lower(trim(severity))=='severe','Severe', lower(trim(severity))=='critical','Critical', toString(null())),",
						"          icd_code = iif(length(upper(regexReplace(icd_code,'[ .-]','')))>3, concat(left(upper(regexReplace(icd_code,'[ .-]','')),3),'.',substring(upper(regexReplace(icd_code,'[ .-]','')),4,10)), upper(regexReplace(icd_code,'[ .-]','')))) ~> derivedColumn1",
						"derivedColumn1 derive(diagnosis_description = case(icd_code=='C50.911','Malignant neoplasm of unspecified site of right female breast', icd_code=='E11.9','Type 2 diabetes mellitus without complications', icd_code=='F32.9','Major depressive disorder, single episode, unspecified', icd_code=='I10','Essential (primary) hypertension', icd_code=='J45.909','Unspecified asthma, uncomplicated', icd_code=='K21.9','Gastro-esophageal reflux disease without esophagitis', icd_code=='M54.5','Low back pain', icd_code=='N39.0','Urinary tract infection, site not specified', icd_code=='R51','Headache', icd_code=='S72.001A','Fracture of unspecified part of neck of right femur, initial encounter', diagnosis_description)) ~> derivedColumn2",
						"derivedColumn2, source2 lookup(admission_id == adm_ref,",
						"     multiple: false,",
						"     pickup: 'any',",
						"     broadcast: 'auto')~> exist1",
						"exist1 filter(!isNull(diagnosis_id) && !isNull(adm_ref) && regexMatch(icd_code,'[A-Z][0-9]{2}([.][0-9A-Z]{1,4})?')) ~> filter",
						"filter sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          diagnosis_id as integer,",
						"          admission_id as integer,",
						"          icd_code as string,",
						"          diagnosis_description as string,",
						"          severity as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          diagnosis_id,",
						"          admission_id,",
						"          icd_code,",
						"          diagnosis_description,",
						"          severity",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_plata_facturacion')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "plata"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "bronce_facturacion",
								"type": "DatasetReference"
							},
							"name": "source1"
